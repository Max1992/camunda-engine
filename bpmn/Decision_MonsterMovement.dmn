  <decision id="Decision_MonsterMovement" name="Определение движения монстра" camunda:historyTimeToLive="180">
    <decisionTable id="DecisionTable_18n10n8" hitPolicy="FIRST">
      <input id="InputClause_1cpjx39" label="monsterType">
        <inputExpression id="LiteralExpression_1v7siwl" typeRef="string" expressionLanguage="feel">
          <text>monsterType</text>
        </inputExpression>
      </input>
      <input id="InputClause_0i9usv0" label="mythosSymbol" biodi:width="270">
        <inputExpression id="LiteralExpression_0enzch8" typeRef="boolean">
          <text>list contains(mythosSymbol, monsterSymbol)</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0o37jzd" label="movementAction" name="movementAction" typeRef="string" />
      <rule id="DecisionRule_1y8u4hf">
        <inputEntry id="UnaryTests_1v6qiqb">
          <text>-</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ds0de3">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_19vy3w7">
          <text>"STAY"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1y5p100">
        <inputEntry id="UnaryTests_0zbigqh">
          <text>"STATIONARY"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_00xdzca">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0wqihlh">
          <text>"STAY"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0bcxy4g">
        <inputEntry id="UnaryTests_0lvioo8">
          <text>"NORMAL"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_172kfh6">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1tmu2uo">
          <text>"MOVE_BY_ARROW"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_09epk92">
        <inputEntry id="UnaryTests_1oa31o7">
          <text>"FLYING"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1shjbod">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1lcw1tv">
          <text>"FLY_TO_SKY"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1gxlqui">
        <inputEntry id="UnaryTests_0rnqnc9">
          <text>"FAST"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1b5u2t7">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_01d6ckj">
          <text>"MOVE_BY_ARROW"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0zj2hpp">
        <inputEntry id="UnaryTests_1plb3dg">
